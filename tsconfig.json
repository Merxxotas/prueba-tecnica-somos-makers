{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "cypress", "@types/jest"],
    "baseUrl": ".",
    "paths": {
      "@cypress/*": ["automatizacion-web-cypress/*"],
      "@playwright/*": ["automatizacion-web-playwright/*"],
      "@api/*": ["pruebas-api/*"]
    }
  },
  "include": [
    "automatizacion-web-cypress/**/*.ts",
    "automatizacion-web-playwright/**/*.ts",
    "pruebas-api/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "cypress/videos",
    "cypress/screenshots",
    "playwright-report",
    "test-results"
  ]
}
